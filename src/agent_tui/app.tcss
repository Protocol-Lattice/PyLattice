Screen {
    background: #0b101b;
    color: #dce5f3;
}
#masthead {
    height: 3;
    padding: 1 2 0 2;
    background: #111a2a;
}
#brand { width: 1fr; text-style: bold; color: #65dcc5; }
#stack-label { width: auto; color: #8b9fbc; }
#workspace-bar {
    height: 2;
    padding: 0 2;
    background: #111a2a;
    border-bottom: solid #24334a;
}
#workspace { width: 1fr; color: #8293ac; }
#policy { width: auto; color: #e9b86b; }
#body { height: 1fr; }
#conversation-pane { width: 1fr; }
#conversation { padding: 1 2; scrollbar-color: #344660; }
.message { height: auto; margin-bottom: 1; padding: 1 2; background: #111a2a; }
.message-role { height: 1; color: #65dcc5; text-style: bold; margin-bottom: 1; }
.message-body { height: auto; margin: 0; padding: 0; }
.user { border-left: thick #a798ef; background: #181d32; }
.user .message-role { color: #b8aafa; }
.assistant { border-left: thick #65dcc5; }
.welcome { border: round #2c3c56; margin: 1 0 2 0; padding: 1 2; }
.welcome .message-role { color: #91a3bc; }
.notice { border-left: thick #e9b86b; }
.notice .message-role { color: #e9b86b; }
.tool-card { height: auto; margin: 0 0 1 1; padding: 0; background: #0f1826;
    border: solid #24334a; }
.tool-content { height: auto; padding: 1; color: #9bacc3; }
.plan-card { height: auto; margin: 0 0 1 0; padding: 0; background: #181d32;
    border: solid #51466d; }
#sidebar { width: 34; background: #0e1624; border-left: solid #24334a; padding: 1 2; }
.section-title { height: 2; color: #65dcc5; text-style: bold; }
#phase { height: 2; color: #dce5f3; }
#routing-mode { height: auto; color: #b8aafa; }
.field-label { height: 1; margin-top: 1; color: #61738f; text-style: bold; }
#router-model, #executor-model, #next-tool { height: auto; color: #c7d3e5; }
#metrics { height: 4; margin-top: 1; padding-top: 1; border-top: solid #24334a; color: #8b9fbc; }
#activity { height: 1fr; background: #0e1624; scrollbar-size: 1 1; }
#composer { height: 6; padding: 0 2 1 2; border-top: solid #24334a; background: #111a2a; }
#composer-label { height: 1; color: #8293ac; }
#input-row { height: 3; }
#prompt { width: 1fr; border: tall #344660; background: #0b101b; }
#prompt:focus { border: tall #65dcc5; }
#run { width: 12; min-width: 10; margin-left: 1; background: #65dcc5; color: #0b101b; }
#stop { width: 9; min-width: 8; margin-left: 1; }
Footer { background: #0b101b; color: #8293ac; }
.compact #sidebar { display: none; }
.compact #stack-label { display: none; }
.compact #conversation { padding: 0 1; }
.compact #composer { padding: 0 1; }
